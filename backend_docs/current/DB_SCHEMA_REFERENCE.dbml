// ============================================================
// RATAB — CURRENT DOMAIN DATABASE (informational only)
// DBML compatible with dbdiagram.io
//
// Frontend MUST NOT depend on table names, foreign keys, Django
// models, migrations, admin, or service internals. Use OPENAPI.yaml
// and FRONTEND_HANDOFF.md for integration.
//
// This snapshot documents the domain schema present after all v0.0
// migrations plus additive v1.0 authentication, workspace, private
// files, messaging, token wallet, subscription/quota, and payment
// boundary migrations, plus the calculation-based token billing
// migration (token_billing_policies, company_token_wallets,
// company_token_wallet_transactions, company_token_donations,
// calculation_billing_receipts, token_billing_policy_audit_events).
// Django framework-owned tables are omitted.
// ============================================================

Enum member_type {
  internal
  client
}

Enum company_role {
  owner
  admin
  employee
}

Enum invitation_status {
  pending
  accepted
  rejected
  cancelled
}

Enum project_status {
  draft
  active
  archived
  closed
}

Enum storage_provider {
  local
  minio
  s3
}

Enum upload_status {
  pending
  ready
  failed
}

Enum message_attachment_type {
  file
  financial_document
}

Enum pricebook_note_type {
  footnote
  requirement
}

Enum coefficient_scope {
  project
  document
  chapter
  row
  line
  custom
}

Enum financial_document_type {
  cost_report
  estimate
  bid_proposal
  payment_statement
  adjustment
  formal_statement
}

Enum financial_document_status {
  draft
  calculated
  locked
  sent
  under_review
  approved
  rejected
  archived
}

Enum financial_line_source {
  pricebook
  starred
  invoice
  paikar_material
  custom
  adjustment
  carried_forward
}

Enum export_format {
  pdf
  print_html
  xlsx
  docx
}

Enum export_status {
  pending
  processing
  ready
  failed
}

Enum token_transaction_type {
  initial_grant
  manual_grant
  pricebook_line_usage
  token_package_purchase
  calculation_usage
  company_donation_debit
  demo_package_credit
}

Enum company_token_transaction_type {
  donation_credit
  calculation_debit
  manual_grant
}

Enum calculation_type {
  official
  starred
}

Enum subscription_status {
  active
  expired
  cancelled
}

Enum subscription_source {
  manual_admin
  demo_commerce
}

Enum subscription_event_type {
  activated
  renewed
  expired
  cancelled
}

Enum token_package_currency {
  IRR
}

Enum payment_order_status {
  created
  pending_provider
  fulfilled
  failed
  cancelled
}

Table app_users {
  id bigint [pk, increment]
  password varchar(128) [not null]
  phone_number varchar(20) [not null, unique]
  display_name varchar(160)
  avatar_file_id bigint
  is_active boolean [not null, default: true]
  is_staff boolean [not null, default: false]
  is_superuser boolean [not null, default: false]
  last_login_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table signup_challenges {
  id uuid [pk]
  phone_number varchar(20) [not null]
  expires_at timestamp [not null]
  verified_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (phone_number, created_at)
    expires_at
  }
}

Table signup_tickets {
  id bigint [pk, increment]
  challenge_id uuid [not null, unique]
  phone_number varchar(20) [not null]
  token_digest varchar(64) [not null, unique]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (phone_number, created_at)
    expires_at
  }
}

Table companies {
  id bigint [pk, increment]
  name varchar(180) [not null]
  legal_name varchar(240)
  registration_number varchar(80)
  national_id varchar(80)
  active_slug varchar(80) [unique]
  owner_member_id bigint
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table company_members {
  id bigint [pk, increment]
  company_id bigint [not null]
  user_id bigint [not null]
  member_type member_type [not null, default: 'internal']
  role company_role [not null]
  display_name varchar(160)
  title varchar(120)
  is_active boolean [not null, default: true]
  permission_settings json [not null, default: '{}', note: 'Role-scoped stored switches only. Employee catalog or Admin-only catalog. Admin inherits Employee capabilities without storing Employee keys.']
  invited_by_member_id bigint
  joined_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, user_id, member_type) [unique]
    (company_id, role)
    company_id [unique, note: 'Partial uniq_active_internal_owner_per_company: member_type=internal AND role=owner AND is_active=true']
  }
}

Table company_member_audit_events {
  id bigint [pk, increment]
  company_id bigint [not null]
  event_type varchar(40) [not null, note: 'ownership_transfer | role_change | permission_change | member_settings_change']
  actor_member_id bigint
  target_member_id bigint
  previous_payload json
  new_payload json
  created_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, event_type, created_at)
  }
}

Table company_slug_history {
  id bigint [pk, increment]
  company_id bigint [not null]
  slug varchar(80) [not null]
  is_active boolean [not null, default: true]
  changed_by_member_id bigint
  activated_at timestamp [not null, default: `now()`]
  deactivated_at timestamp

  indexes {
    (company_id, is_active)
    slug
    slug [unique, note: 'Partial: is_active = true']
    company_id [unique, note: 'Partial: is_active = true']
  }
}

Table company_groups {
  id bigint [pk, increment]
  company_id bigint [not null]
  name varchar(240) [not null]
  description text
  created_by_member_id bigint
  group_type varchar(20) [not null, default: 'custom', note: 'public | project | custom']
  is_default boolean [not null, default: false, note: 'True for system public group; prefer group_type=public']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, is_active)
    (company_id, group_type, is_active)
    (company_id, name) [unique, note: 'Partial: is_active = true']
    company_id [unique, note: 'Partial: is_active = true and is_default = true']
    company_id [unique, note: 'Partial: is_active = true and group_type = public']
  }

  Note: 'Public and project groups are system-managed. Project relation is projects.group_id OneToOne. Custom groups are created via POST /api/companies/{id}/groups/ with optional member_ids that create pending invitations.'
}

Table company_group_memberships {
  id bigint [pk, increment]
  group_id bigint [not null]
  member_id bigint [not null]
  added_by_member_id bigint
  is_active boolean [not null, default: true]
  joined_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (group_id, member_id) [unique]
    (group_id, is_active)
    (member_id, is_active)
  }
}

Table company_membership_invitations {
  id bigint [pk, increment]
  company_id bigint [not null]
  invited_user_id bigint [not null]
  invited_by_member_id bigint [not null]
  target_group_id bigint [not null]
  proposed_role company_role [not null]
  display_name varchar(160)
  title varchar(120)
  status invitation_status [not null, default: 'pending']
  responded_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (invited_user_id, status)
    (company_id, status)
    (target_group_id, status)
    (company_id, invited_user_id, target_group_id) [unique, note: 'Partial: status = pending']
  }

  Note: 'Pending invitations grant no company/group/message/file access. Used for both company onboarding (non-members) and custom-group joins (already-active members selected at group create). Acceptance activates company membership when needed and the target group membership atomically.'
}

Table group_messages {
  id bigint [pk, increment]
  group_id bigint [not null]
  sender_member_id bigint [not null]
  text text [not null, note: 'May be blank only when attachments are created atomically by the messaging service. Soft-deleted responses expose tombstone text, not this stored body.']
  created_at timestamptz [not null]
  edited_at timestamptz
  is_deleted boolean [not null, default: false]
  deleted_at timestamptz
  deleted_by_member_id bigint
  is_system boolean [not null, default: false]
  client_message_id varchar(128) [not null, default: '', note: 'Empty when no client idempotency key was supplied']
  request_fingerprint varchar(64) [not null, default: '']
  forwarded_from_message_id bigint
  forward_snapshot jsonb

  indexes {
    (group_id, created_at, id)
    (sender_member_id, created_at)
    (group_id, is_deleted, created_at)
    (sender_member_id, client_message_id) [unique, note: 'Partial: client_message_id is not empty']
  }
}

Table message_lifecycle_events {
  id bigint [pk, increment]
  message_id bigint [not null]
  event_type varchar(20) [not null, note: 'created|edited|deleted|forwarded']
  actor_member_id bigint
  previous_payload jsonb [not null, default: '{}']
  new_payload jsonb [not null, default: '{}']
  created_at timestamptz [not null]

  indexes {
    (message_id, event_type, created_at)
  }
}

Table message_attachments {
  id bigint [pk, increment]
  message_id bigint [not null]
  attachment_type message_attachment_type [not null]
  storage_file_id bigint
  financial_document_id bigint
  created_at timestamptz [not null]

  Note: 'New attachments may only use file or financial_document. project is not an allowed create type; historical rows are preserved if present. References existing file/document targets; never copies content. Soft-deleted parent messages hide attachment cards in normal serializers.'

  indexes {
    (message_id, attachment_type)
    (message_id, storage_file_id) [unique, note: 'Partial: storage_file_id is not null']
    (message_id, financial_document_id) [unique, note: 'Partial: financial_document_id is not null']
  }
}

Table projects {
  id bigint [pk, increment]
  company_id bigint [not null]
  created_by_member_id bigint [not null]
  group_id bigint [unique, note: 'One-to-one linked company group; required after create']
  project_code varchar(80)
  name varchar(240) [not null]
  contract_number varchar(120)
  employer_name varchar(240)
  consultant_name varchar(240)
  contractor_name varchar(240)
  executive_agency_name varchar(240)
  base_year int
  status project_status [not null, default: 'draft']
  starts_on date
  ends_on date
  description text
  include_all_company_members_in_group boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, project_code) [unique]
  }

  Note: 'Project create is atomic with its linked group. include_all_company_members_in_group controls current + future auto-join behavior.'
}

Table storage_files {
  id bigint [pk, increment]
  company_id bigint
  uploaded_by_member_id bigint
  original_filename varchar(255) [not null]
  content_type varchar(120)
  byte_size bigint
  storage_provider storage_provider [not null, default: 'local']
  storage_key varchar(500) [not null]
  sha256 varchar(128)
  is_public boolean [not null, default: false]
  upload_status upload_status [not null, default: 'ready']
  failure_reason varchar(240)
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (company_id, sha256)
    (company_id, upload_status)
    (upload_status, created_at)
  }

  Note: 'byte_size is constrained to NULL or a non-negative value'
}

Table pricebooks {
  id bigint [pk, increment]
  code varchar(40) [not null, unique]
  title_fa varchar(240) [not null]
  official_title_fa varchar(240) [not null, default: '']
  discipline varchar(80)
  base_year int
  sort_order int [not null, default: 0]
  source_root varchar(500) [not null, default: '']
  legacy_aliases json [not null, default: '[]']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]

  Note: 'Pricebook = family/type. code has no year (e.g. building). ABN1404 is legacy alias only.'
}

Table pricebook_editions {
  id bigint [pk, increment]
  pricebook_id bigint [not null]
  code varchar(80) [not null, unique]
  year int [not null]
  title_fa varchar(240) [not null]
  currency_code varchar(12) [not null, default: 'IRR']
  source_file_id bigint
  source_dir varchar(500) [not null, default: '']
  is_locked boolean [not null, default: true]
  is_active boolean [not null, default: true]
  is_stale boolean [not null, default: false]
  published_at timestamp
  materialized_at timestamp
  materialization_version varchar(40) [not null, default: '']
  manifest_hash varchar(64) [not null, default: '']
  base_structure_hash varchar(64) [not null, default: '']
  overlay_hash varchar(64) [not null, default: '']
  effective_structure_hash varchar(64) [not null, default: '']
  prices_hash varchar(64) [not null, default: '']
  root_files_hash varchar(64) [not null, default: '']
  final_calculate_source_year int
  final_calculate_relative_path varchar(240) [not null, default: '']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (pricebook_id, year) [unique]
  }

  Note: 'Edition = family + year. Official price set code is official-<year>. is_base_year is derived (year == pricebook.base_year).'
}

Table pricebook_chapters {
  id bigint [pk, increment]
  edition_id bigint [not null]
  chapter_code varchar(2) [not null]
  title_fa varchar(240) [not null]
  sort_order int [not null]

  indexes {
    (edition_id, chapter_code) [unique]
  }
}

Table pricebook_groups {
  id bigint [pk, increment]
  chapter_id bigint [not null]
  group_code varchar(2) [not null]
  title_fa varchar(240)
  sort_order int [not null]

  indexes {
    (chapter_id, group_code) [unique]
  }
}

Table pricebook_rows {
  id bigint [pk, increment]
  group_id bigint [not null]
  row_code varchar(6) [not null]
  title_fa text [not null]
  short_title_fa varchar(240)
  description_fa text [not null, default: '']
  unit varchar(80) [not null]
  is_star_allowed boolean [not null, default: false]
  sort_order int [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (group_id, row_code) [unique]
    (group_id, sort_order)
  }
}

Table pricebook_price_sets {
  id bigint [pk, increment]
  edition_id bigint [not null]
  code varchar(80) [not null]
  title_fa varchar(240) [not null]
  imported_file_id bigint
  is_active boolean [not null, default: true]
  imported_at timestamp
  created_at timestamp [not null, default: `now()`]

  indexes {
    (edition_id, code) [unique]
  }
}

Table pricebook_row_prices {
  id bigint [pk, increment]
  price_set_id bigint [not null]
  row_id bigint [not null]
  unit_price decimal(20,4) [not null]
  currency_code varchar(12) [not null, default: 'IRR']

  indexes {
    (price_set_id, row_id) [unique]
  }
}

Table pricebook_logical_items {
  id bigint [pk, increment]
  group_id bigint [not null]
  item_key varchar(40) [not null]
  short_name_fa varchar(240) [not null]
  unit varchar(80) [not null]
  data_type varchar(40) [not null, default: 'number']
  min_value decimal(20,6) [default: 0]
  max_value decimal(20,6)
  has_more_details boolean [not null, default: false]
  sort_order int [not null]
  properties_json jsonb

  indexes {
    (group_id, item_key) [unique]
  }
}

Table pricebook_item_rows {
  id bigint [pk, increment]
  item_id bigint [not null]
  row_id bigint [not null]
  min_value decimal(20,6)
  max_value decimal(20,6)
  selection_rule varchar(120)
  sort_order int [not null]

  indexes {
    (item_id, row_id) [unique]
  }
}

Table pricebook_notes {
  id bigint [pk, increment]
  edition_id bigint [not null]
  note_type pricebook_note_type [not null]
  note_code varchar(120) [not null]
  source_token varchar(80) [not null]
  clause_code varchar(80) [not null]
  title_fa varchar(240)
  body_fa text [not null]
  affects_calculation boolean [not null, default: false]
  metadata_json jsonb
  created_at timestamp [not null, default: `now()`]

  indexes {
    (edition_id, note_code) [unique]
  }
}

Table pricebook_row_notes {
  id bigint [pk, increment]
  row_id bigint [not null]
  note_id bigint [not null]
  is_default_visible boolean [not null, default: true]

  indexes {
    (row_id, note_id) [unique]
  }
}

Table project_coefficient_sets {
  id bigint [pk, increment]
  project_id bigint [not null]
  name varchar(160) [not null]
  is_default boolean [not null, default: false]
  created_by_member_id bigint [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (project_id, name) [unique]
  }
}

Table project_coefficient_values {
  id bigint [pk, increment]
  coefficient_set_id bigint [not null]
  coefficient_key varchar(80) [not null]
  scope coefficient_scope [not null, default: 'project']
  chapter_id bigint
  row_id bigint
  label_fa varchar(160) [not null]
  multiplier decimal(18,8) [not null, default: 1]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (coefficient_set_id, coefficient_key, scope, chapter_id, row_id) [unique]
  }
}

Table financial_documents {
  id bigint [pk, increment]
  company_id bigint [not null]
  project_id bigint [not null]
  document_type financial_document_type [not null, default: 'cost_report']
  document_number varchar(80)
  title varchar(240) [not null]
  report_title varchar(240)
  document_date date
  period_start_on date
  period_end_on date
  status financial_document_status [not null, default: 'draft']
  pricebook_edition_id bigint [not null]
  price_set_id bigint [not null]
  coefficient_set_id bigint
  created_by_member_id bigint [not null]
  calculated_at timestamp
  locked_at timestamp
  locked_by_member_id bigint
  sent_at timestamp
  totals_snapshot_json jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, project_id, document_number)
    (project_id, document_type)
  }
}

Table financial_document_lines {
  id bigint [pk, increment]
  document_id bigint [not null]
  line_no int [not null]
  line_source financial_line_source [not null, default: 'pricebook']
  pricebook_item_id bigint
  pricebook_row_id bigint
  row_code_snapshot varchar(40)
  chapter_code_snapshot varchar(10)
  chapter_title_snapshot varchar(240)
  description_snapshot text [not null]
  unit_snapshot varchar(80) [not null]
  quantity decimal(24,6) [not null]
  manual_unit_price decimal(20,4)
  unit_price_snapshot decimal(20,4) [not null]
  base_amount_snapshot decimal(24,4) [not null]
  coefficient_amount_snapshot decimal(24,4) [not null, default: 0]
  total_amount_snapshot decimal(24,4) [not null]
  calculation_input_json jsonb
  calculation_output_json jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (document_id, line_no) [unique]
    (document_id, chapter_code_snapshot)
  }
}

Table financial_document_line_coefficients {
  id bigint [pk, increment]
  line_id bigint [not null]
  coefficient_key varchar(80) [not null]
  label_fa varchar(160) [not null]
  multiplier decimal(18,8) [not null]
  applied_amount decimal(24,4) [not null]
  source_coefficient_value_id bigint

  indexes {
    (line_id, coefficient_key)
  }
}

Table financial_document_chapter_totals {
  id bigint [pk, increment]
  document_id bigint [not null]
  chapter_code_snapshot varchar(10) [not null]
  chapter_title_snapshot varchar(240) [not null]
  pricebook_amount decimal(24,4) [not null, default: 0]
  starred_amount decimal(24,4) [not null, default: 0]
  invoice_amount decimal(24,4) [not null, default: 0]
  paikar_material_amount decimal(24,4) [not null, default: 0]
  raw_total_amount decimal(24,4) [not null, default: 0]
  coefficient_total_amount decimal(24,4) [not null, default: 0]
  final_total_amount decimal(24,4) [not null, default: 0]
  sort_order int [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (document_id, chapter_code_snapshot) [unique]
  }
}

Table document_print_templates {
  id bigint [pk, increment]
  company_id bigint
  code varchar(80) [not null]
  title_fa varchar(240) [not null]
  document_type financial_document_type [not null]
  template_json jsonb [not null]
  is_default boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (company_id, code) [unique]
  }
}

Table financial_document_exports {
  id bigint [pk, increment]
  document_id bigint [not null]
  template_id bigint
  export_format export_format [not null]
  status export_status [not null, default: 'pending']
  file_id bigint
  render_snapshot_json jsonb
  error_message text
  requested_by_member_id bigint [not null]
  requested_at timestamp [not null, default: `now()`]
  finished_at timestamp

  indexes {
    (document_id, export_format, requested_at)
  }
}

Table token_wallets {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  balance decimal(20,0) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'balance >= 0; changes are made only with ledger transactions'
}

Table token_wallet_transactions {
  id bigint [pk, increment]
  wallet_id bigint [not null]
  transaction_type token_transaction_type [not null]
  amount decimal(20,0) [not null]
  balance_after decimal(20,0) [not null]
  actor_user_id bigint
  reason varchar(240) [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (wallet_id, created_at)
  }

  Note: 'append-only; amount != 0; balance_after >= 0'
}

Table pricebook_usage_logs {
  id bigint [pk, increment]
  wallet_id bigint [not null]
  company_id bigint [not null]
  member_id bigint [not null]
  document_id bigint [not null]
  line_id bigint [unique]
  pricebook_item_id bigint
  pricebook_row_id bigint
  ledger_transaction_id bigint [not null, unique]
  token_cost decimal(20,0) [not null]
  idempotency_key varchar(128) [not null]
  request_fingerprint varchar(64) [not null]
  row_code_snapshot varchar(40) [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (wallet_id, idempotency_key) [unique]
    (wallet_id, created_at)
    (company_id, created_at)
    (document_id, created_at)
  }

  Note: 'HISTORICAL/LEGACY: rows from the superseded fixed 5-token official
  line-create charge. No new rows are written by current billing code;
  current official/starred charges write calculation_billing_receipts
  instead. token_cost > 0; line may become null after an audited line
  deletion. Kept for historical ledger continuity.'
}

Table token_billing_policies {
  id bigint [pk, increment]
  official_calculation_cost decimal(20,0) [not null, default: 2]
  starred_calculation_cost decimal(20,0) [not null, default: 1]
  new_account_initial_grant decimal(20,0) [not null, default: 12]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'Effectively a singleton (BillingPolicyService.get_policy lazily
  creates the one row if missing). Admin-editable via Django admin only;
  every change is recorded in token_billing_policy_audit_events. All three
  costs/grant are >= 0.'
}

Table token_billing_policy_audit_events {
  id bigint [pk, increment]
  policy_id bigint [not null]
  actor_user_id bigint
  field_name varchar(64) [not null]
  old_value decimal(20,0) [not null]
  new_value decimal(20,0) [not null]
  created_at timestamp [not null, default: `now()`]

  Note: 'Append-only audit trail of TokenBillingPolicy field changes, written
  by BillingPolicyService.update_policy.'
}

Table company_token_wallets {
  id bigint [pk, increment]
  company_id bigint [not null, unique]
  balance decimal(20,0) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'One wallet per company; balance >= 0. Used only as a fallback funding
  source for calculation charges once a member personal wallet is exhausted.
  Funded only by donations (or manual admin grant); no company->user
  withdrawal path exists.'
}

Table company_token_wallet_transactions {
  id bigint [pk, increment]
  wallet_id bigint [not null]
  transaction_type company_token_transaction_type [not null]
  amount decimal(20,0) [not null]
  balance_after decimal(20,0) [not null]
  actor_user_id bigint
  reason varchar(240) [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (wallet_id, created_at)
  }

  Note: 'append-only; amount != 0; balance_after >= 0'
}

Table company_token_donations {
  id bigint [pk, increment]
  company_id bigint [not null]
  donor_user_id bigint [not null]
  donor_member_id bigint [not null]
  amount decimal(20,0) [not null]
  personal_ledger_id bigint [not null, unique]
  company_ledger_id bigint [not null, unique]
  idempotency_key varchar(128) [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (donor_user_id, company_id, idempotency_key) [unique]
  }

  Note: 'amount > 0. Records a single atomic transfer of tokens from a member
  personal wallet (personal_ledger, company_donation_debit) into their
  company wallet (company_ledger, donation_credit). Any active internal
  company member may donate; there is no reverse withdrawal.'
}

Table official_calculation_sessions {
  id bigint [pk, increment]
  public_id uuid [not null, unique]
  user_id bigint [not null]
  company_id bigint [not null]
  member_id bigint [not null]
  document_id bigint [not null]
  pricebook_item_id bigint [not null]
  is_paid boolean [not null, default: false]
  applied_cost decimal(20,0) [not null, default: 0]
  first_receipt_id bigint
  latest_receipt_id bigint
  expires_at timestamp [not null]
  closed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, document_id, pricebook_item_id, created_at)
    (expires_at)
  }

  Note: 'Server-issued official item modal session. Opening is free.
  First successful authoritative calculation marks is_paid and charges
  applied_cost (personal then company). Later successful recalculations in
  the same open session are free and update latest_receipt_id. Reopening the
  modal requires a new session. applied_cost >= 0.'
}

Table calculation_billing_receipts {
  id bigint [pk, increment]
  calculation_type calculation_type [not null]
  session_id bigint
  user_id bigint [not null]
  company_id bigint [not null]
  member_id bigint [not null]
  document_id bigint [not null]
  pricebook_item_id bigint
  input_snapshot_json jsonb [not null]
  result_snapshot_json jsonb [not null]
  payload_fingerprint varchar(64) [not null]
  applied_cost decimal(20,0) [not null]
  personal_debit decimal(20,0) [not null, default: 0]
  company_debit decimal(20,0) [not null, default: 0]
  personal_ledger_id bigint
  company_ledger_id bigint
  line_id bigint [unique]
  idempotency_key varchar(128) [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, idempotency_key) [unique]
    (document_id, created_at)
    (company_id, created_at)
  }

  Note: 'Charge/receipt record for official/starred calculations. Official
  receipts may link to official_calculation_sessions; first success in an
  unpaid session charges, later same-session successes may have applied_cost
  0. line_id is filled once via ReceiptLineService from the session latest
  receipt; that step never charges. Stale (non-latest) session receipts cannot
  create lines. applied_cost/personal_debit/company_debit >= 0.'
}

Table subscription_plans {
  id bigint [pk, increment]
  code varchar(40) [not null, unique]
  title_fa varchar(160) [not null]
  description_fa text [not null]
  daily_message_limit integer
  max_attachment_bytes_per_message bigint
  duration_days integer [not null]
  price_amount decimal(18,4) [not null, default: 0]
  currency varchar(8) [not null, default: 'IRR']
  is_active boolean [not null, default: true]
  display_order integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (is_active, code)
  }

  Note: 'duration_days > 0; price_amount >= 0; null daily_message_limit or
  null max_attachment_bytes_per_message means unlimited. Seeded rows: bronze
  (free fallback, is_active=true), silver (paid, is_active=true), gold
  (is_active=false, unavailable). is_active is catalog availability only —
  the API exposes it as is_available and separately reports is_current /
  is_free_fallback / can_activate per requesting user. Ordered by
  display_order then code.'
}

Table user_subscriptions {
  id bigint [pk, increment]
  user_id bigint [not null]
  plan_id bigint [not null]
  status subscription_status [not null, default: 'active']
  plan_code_snapshot varchar(40) [not null]
  daily_message_limit_snapshot integer
  max_attachment_bytes_snapshot bigint
  starts_at timestamp [not null]
  ends_at timestamp [not null]
  source subscription_source [not null, default: 'manual_admin']
  activated_by_user_id bigint
  note varchar(240) [not null]
  closed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id) [unique, note: 'partial: only where status = active']
    (user_id, status, ends_at)
    (status, ends_at)
  }

  Note: 'ends_at > starts_at; at most one active subscription per user. Only
  a valid paid subscription row here is ever "effective"; the free Bronze
  fallback never gets a row — the effective plan resolves to the Bronze
  catalog row directly when no row exists here.'
}

Table user_subscription_events {
  id bigint [pk, increment]
  subscription_id bigint [not null]
  event_type subscription_event_type [not null]
  previous_ends_at timestamp
  new_ends_at timestamp
  actor_user_id bigint
  note varchar(240) [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (subscription_id, created_at)
  }

  Note: 'append-only subscription audit trail'
}

Table daily_message_usages {
  id bigint [pk, increment]
  user_id bigint [not null]
  usage_date date [not null]
  message_count integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, usage_date) [unique]
    (usage_date, user_id)
  }

  Note: 'one row per user per local calendar day; incremented under a row lock'
}

Table token_packages {
  id bigint [pk, increment]
  code varchar(40) [not null, unique]
  title_fa varchar(160) [not null]
  token_amount decimal(20,0) [not null]
  price_amount decimal(18,4) [not null]
  currency token_package_currency [not null, default: 'IRR']
  is_active boolean [not null, default: true]
  display_order integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (is_active, code)
  }

  Note: 'token_amount > 0; price_amount >= 0; the only source of payable
  values. Ordered by display_order then code. Real online purchase remains
  disabled; Local/Development may fulfill via demo provider without
  re-reading package price at credit time.'
}

Table payment_orders {
  id bigint [pk, increment]
  user_id bigint [not null]
  token_package_id bigint [not null]
  status payment_order_status [not null, default: 'created']
  package_code_snapshot varchar(40) [not null]
  token_amount_snapshot decimal(20,0) [not null]
  price_amount_snapshot decimal(18,4) [not null]
  currency_snapshot varchar(8) [not null]
  idempotency_key varchar(128) [not null]
  provider varchar(40) [not null]
  provider_reference varchar(128) [not null]
  verified_amount decimal(18,4)
  verified_at timestamp
  fulfilled_at timestamp
  failure_reason varchar(240) [not null]
  ledger_transaction_id bigint [unique]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, idempotency_key) [unique]
    (provider, provider_reference) [unique, note: 'partial: only where provider_reference <> empty']
    (user_id, created_at)
    (status, created_at)
  }

  Note: 'token/price values are snapshotted from token_packages; a fulfilled order always has a ledger transaction'
}

