# Frontend API base URL (no trailing slash).
# Local Backend v1 Docker API is commonly published on host port 15000.
VITE_API_BASE_URL=http://localhost:15000

# For session+CSRF auth from the Vite origin http://localhost:1000, the backend
# local/dev environment must include these non-secret values (examples):
#   CSRF_TRUSTED_ORIGINS=http://localhost:1000,http://127.0.0.1:1000
#   CORS_ALLOWED_ORIGINS=http://localhost:1000,http://127.0.0.1:1000
#   CORS_ALLOW_CREDENTIALS=true
#   SESSION_COOKIE_SAMESITE=Lax
#   CSRF_COOKIE_SAMESITE=Lax
#   SIGNUP_VERIFICATION_MODE=local_any_code   # local debug only
# Do not put secrets, session IDs, or real credentials in this file.

# Deprecated dev-only fallback. Normal flow uses edition.active_price_set.id from the backend.
VITE_DEFAULT_PRICE_SET_ID=
